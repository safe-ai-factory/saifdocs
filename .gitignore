node_modules/
dist/
dist-pack/
coverage/
*.tsbuildinfo
*.tgz
.pnpm-store/

# Generated by `saifdocs gen`
docspec/.manifest.json

# saifctl run artifacts (can be very large; not part of source)
.saifctl/

# Test fixture pollution: never commit feature dirs emitted INTO the fixture project
src/manifest/__fixtures__/**/saifctl/

# Generated documentation output (regenerated by 'saifdocs gen' + 'saifctl feat run').
# Use docs/* (not docs/) so direct-child re-inclusion patterns below actually fire —
# git won't look inside an ignored directory, so a `docs/` parent rule blocks
# `!docs/<x>` exceptions. https://git-scm.com/docs/gitignore
docs/*
# But keep human-authored design notes:
!docs/design.md
