# Defensive .npmignore — paired with the `files` allowlist in package.json,
# which is the primary mechanism for what ships. Items below are
# secondary safeguards: if `files` is ever modified or removed, these
# patterns still keep dev/test/planning junk out of the published tarball.

# Tests and coverage
**/*.test.ts
**/*.test.tsx
**/*.test.js
**/__tests__/**
**/__fixtures__/**
**/tests/**
test/
coverage/
.nyc_output/
vitest.config.ts
vitest.config.js

# Build inputs / dev tooling
src/**/*.ts
tsconfig*.json
tsup.config.ts
eslint.config.js
.eslintrc*
knip.json
.prettierrc*
.editorconfig

# Caches / outputs we don't ship
dist-pack/
node_modules/
.pnpm-store/
*.tsbuildinfo

# Generated docs (regenerated by saifdocs gen + saifctl feat run)
docs/
docs_old/

# Repo + CI hygiene (unrelated to runtime)
.github/
.cursor/
.claude/
.saifctl/
scripts/
docspec/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Tarballs (build outputs, not source)
*.tgz
